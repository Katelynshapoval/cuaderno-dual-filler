{
  "manifest_version": 3,
  "name": "Cuaderno Dual",
  "version": "1.0.0",
  "description": "Rellena el cuaderno de seguimiento desde una fecha hasta hoy, con tus horas y tu texto.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://aplicaciones.aragon.es/*"],
  "action": {
    "default_title": "Abrir el panel del cuaderno",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://aplicaciones.aragon.es/*"],
      "js": ["shared/plan.js", "shared/calendar.js", "panel/panel.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel/panel.css"],
      "matches": ["https://aplicaciones.aragon.es/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
